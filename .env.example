# Copiá este archivo como .env para cambiar los valores por defecto.
# Compose lo lee solo; ninguna variable es obligatoria.

# Segundos de espera en la cola antes de responder 503.
QUEUE_TIMEOUT_SECONDS=20
# Valor del header Retry-After ante saturación.
RETRY_AFTER_SECONDS=1
# Formato de salida: markdown o text.
OUTPUT_FORMAT=markdown
# Rate limit de Traefik por cliente.
RATE_LIMIT_AVERAGE=20
RATE_LIMIT_BURST=40
